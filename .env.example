# DeepSeek API Key（前端直接调用）
# 申请地址：https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_KEY=your_deepseek_api_key_here

# Supabase（数据存储 + 邮箱认证）
# 在 Supabase 控制台 Settings > API 中获取
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 以下变量配置在 Supabase Edge Function 的 Secrets 中（不放前端）
# Dashboard → Edge Functions → send-email → Secrets
# ─────────────────────────────────────────────────────────────────────────────

# Resend 邮件服务（https://resend.com，免费 3000封/月，注册即用无需备案）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 发件人地址
# ⚠️ 未验证自定义域名时，免费套餐只能用：onboarding@resend.dev（仅发给自己账号的邮箱）
# 验证域名后可改为：CookAI <noreply@yourdomain.com>
EMAIL_FROM=CookAI <onboarding@resend.dev>

# 应用地址（用于构造邮件中的验证跳转链接）
SITE_URL=http://localhost:3000
